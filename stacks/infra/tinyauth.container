# ==============================================================================
# Tinyauth: forward authentication bridge
# ------------------------------------------------------------------------------
# Sits between Caddy and the applications that have no SSO of their own. Caddy
# asks it whether a request is authorised; if not, it runs the OIDC flow against
# Pocket ID and the passkey prompt happens there.
#
# The whitelist matters: without it, any account Pocket ID knows about can sign
# in to everything.
#
# AUTHURL and REDIRECTURL are public because the BROWSER follows them. TOKENURL
# and USERINFOURL are back-channel calls Tinyauth makes itself, so they stay on
# net-ingress rather than leaving the network and hairpinning through the
# router's NAT to reach a container two addresses away.
#
# Image:  https://github.com/tinyauthapp/tinyauth/pkgs/container/tinyauth
# See:    https://tinyauth.app/docs/guides/pocket-id
# ==============================================================================

[Unit]
Description=Tinyauth
After=pocket-id.service

[Container]
# :v5, the line already running. Together with Pocket ID this gates sign-on for
# every service, and the two are coupled - the X-Tinyauth-Location behaviour and
# Pocket ID's exact-origin check have both cost time before. Pinning the major
# keeps a breaking release from landing on both at once, unwatched.
Image=ghcr.io/tinyauthapp/tinyauth:v5
AutoUpdate=registry
ContainerName=tinyauth
Network=net-ingress.network

Volume=${DOCKER_VOLUME_CONFIG}/tinyauth:/data:Z

Environment=TZ=${TIMEZONE}
Environment=TINYAUTH_APPURL=https://auth.${DOMAIN}
Environment=TINYAUTH_DATABASE_PATH=/data/tinyauth.db
# Everything reaches Tinyauth through Caddy, so without this it would see
# Caddy's address as the client and every IP-based rule would be wrong.
Environment=TINYAUTH_AUTH_TRUSTEDPROXIES=${NET_SUBNET_INGRESS}
Environment=TINYAUTH_AUTH_SECURECOOKIE=true
# Skip Tinyauth's own login page and go straight to the passkey prompt.
Environment=TINYAUTH_OAUTH_AUTOREDIRECT=pocketid
Environment="TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=Pocket ID"
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=${POCKETID_CLIENT_ID}
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=${POCKETID_CLIENT_SECRET}
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://id.${DOMAIN}/authorize
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=http://pocket-id:1411/api/oidc/token
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=http://pocket-id:1411/api/oidc/userinfo
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_REDIRECTURL=https://auth.${DOMAIN}/api/oauth/callback/pocketid
# QUOTED, and it must stay that way. Quadlet parses Environment= as
# space-separated KEY=VALUE pairs, so unquoted this set only "openid" and
# discarded the rest in silence. Without the email scope Pocket ID returns no
# email claim, Tinyauth logs "OAuth provider did not return an email" and
# sends a successfully authenticated user to its error page - a passkey that
# works followed by a failure that looks unrelated to it.
Environment="TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid email profile groups"
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_WHITELIST=${AUTH_WHITELIST}
# Tinyauth logs to stderr, which podman's journald driver records as priority 3
# - so its per-request HTTP log was 466 journal ERRORS a day, 365 of them
# successful 200s. Caddy already keeps an access log of exactly the same
# requests, so this stream is pure duplication and it goes.
#
# The audit stream is off by default and is the one an auth service should
# actually keep: who signed in, when, and whether it worked.
Environment=TINYAUTH_LOG_STREAMS_HTTP_ENABLED=false
Environment=TINYAUTH_LOG_STREAMS_AUDIT_ENABLED=true

# wget, not curl - this image ships no curl.
HealthCmd=wget -qO- http://localhost:3000/healthz || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
# See sonarr.container.
HealthStartupCmd=wget -qO- http://localhost:3000/healthz || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=default.target
