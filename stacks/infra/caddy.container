# ==============================================================================
# Caddy: reverse proxy and single TLS terminator
# ------------------------------------------------------------------------------
# The only path into any application from outside, and the only container that
# joins more than one trust boundary. It gets a leg in each segment rather than
# a shared "proxy" network containing everything with a UI, which would just
# re-flatten the topology. It is deliberately absent from net-solver.
#
# Certificates are issued per site block, on demand, over DNS-01. There is no
# certificate list to maintain, and a hostname with no block in the Caddyfile
# gets no certificate and fails the TLS handshake - so unlisted names are closed
# by construction rather than by remembering to remove them.
#
# ROOTLESS: binding 80 and 443 as a normal user needs
# net.ipv4.ip_unprivileged_port_start=80, shipped as a sysctl drop-in in
# host/butane/. Without it this unit fails with "permission denied" on bind and
# nothing else in the stack is reachable.
#
# /data holds the certificates, private keys and the ACME account. It is not
# regenerable without re-issuing everything, so it belongs in the backup.
# ==============================================================================

[Unit]
Description=Caddy reverse proxy
After=tinyauth.service

[Container]
Image=caddy.build
# `local`, not `registry`: this image is built here, so there is no tag upstream
# to resolve. Local policy compares the running container against the image of
# the same name in local storage and restarts if they differ.
#
# IT DOES NOT TRIGGER THE BUILD. Nothing would ever produce a newer image, and
# Caddy would silently never update - which is why media-stack-caddy-build.timer
# exists. That rebuilds weekly; this notices the result.
AutoUpdate=local
ContainerName=caddy
Network=net-ingress.network
Network=net-arr.network
Network=net-download.network
Network=net-media.network
Network=net-transcode.network

# Mounted as a directory, not a single file, so that a `git pull` replacing the
# Caddyfile does not leave the container holding a stale inode. Shared and
# read-only, so :z rather than :Z.
Volume=/var/media-stack/apps/caddy:/etc/caddy:z,ro
Volume=${DOCKER_VOLUME_CONFIG}/caddy/data:/data:Z
Volume=${DOCKER_VOLUME_CONFIG}/caddy/config:/config:Z

PublishPort=${PORT_CADDY_HTTP}:80
PublishPort=${PORT_CADDY_HTTPS}:443

Environment=TZ=${TIMEZONE}
Environment=DOMAIN=${DOMAIN}
Environment=GANDI_BEARER_TOKEN=${GANDI_BEARER_TOKEN}
# Upstream ports for the services whose listening port is itself set from the
# environment, so the Caddyfile cannot drift from the service config.
Environment=PORT_TDARR_WEB=${PORT_TDARR_WEB}
Environment=PORT_QBITTORRENT_WEB=${PORT_QBITTORRENT_WEB}
Environment=PORT_JOAL_WEB=${PORT_JOAL_WEB}

# The admin API on 2019 is bound inside the container only, and answering on it
# proves the config loaded - which a TCP check on 443 does not.
HealthCmd=curl -fsS http://localhost:2019/config/ || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
# See sonarr.container. Note what this check does and does not prove: the admin
# API on 2019 answering means the config parsed and loaded, NOT that Caddy can
# still issue certificates. After a Caddy update, read `journalctl --user -u
# caddy` for ACME errors rather than trusting a green healthcheck.
HealthStartupCmd=curl -fsS http://localhost:2019/config/ || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5
# First start builds the image, which compiles Caddy from source.
TimeoutStartSec=900

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
