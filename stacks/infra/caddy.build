# ==============================================================================
# Build: Caddy with the Gandi DNS provider
# ------------------------------------------------------------------------------
# The only image here that is not pulled. The official Caddy image ships no DNS
# provider modules, and certificates are issued over DNS-01 against Gandi, so
# the binary has to be rebuilt with the provider compiled in.
#
# A .build unit makes that part of the dependency graph rather than a step
# someone has to remember: caddy.container references this image, so systemd
# builds it before starting the proxy.
#
# Reproducible like everything else here: ingress/Dockerfile pins both of its
# FROM lines by digest, so this builds the same proxy on the new host as the one
# running today. That is the point - this unit runs on first boot of a machine
# nobody has used yet, and Caddy is the only path to every service on it.
# ==============================================================================

[Unit]
Description=Build Caddy with caddy-dns/gandi

[Build]
ImageTag=localhost/media-stack/caddy:latest
File=/var/media-stack/ingress/Dockerfile
SetWorkingDirectory=/var/media-stack/ingress

# WITHOUT THIS THE WEEKLY REBUILD IS DECORATIVE. podman build's default pull
# policy is `missing`: once docker.io/library/caddy:2 exists in local storage
# under that tag, it is reused and upstream is never consulted again. The build
# would keep succeeding, keep taking four seconds, and keep producing the same
# binary - so Caddy, alone in this stack, would never update while looking like
# it did.
#
# `newer` makes it check the registry each time and pull only when the tag has
# actually moved. One manifest request a week.
Pull=newer
