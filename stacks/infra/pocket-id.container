# ==============================================================================
# Pocket ID: passkey-only OpenID Connect provider
# ------------------------------------------------------------------------------
# There are no passwords to phish, leak or rotate - authentication is a WebAuthn
# signature from a device the user already carries.
#
# It is only a provider: it has no forward-auth endpoint, which is what Tinyauth
# is for. Applications that speak OIDC natively can point straight here.
#
# Alone with Caddy and Tinyauth on net-ingress, and publishes no port. It is
# reached only through Caddy, which is also what gives it the HTTPS that
# WebAuthn refuses to work without.
#
# APP_URL must match the browser's origin EXACTLY, port included. WebAuthn
# strips the port when deriving the relying-party ID, but the server validates
# the full origin string separately, and a mismatch fails registration at the
# last step with an unhelpful "couldn't process the response from your passkey".
#
# ENCRYPTION_KEY protects the passkey and OIDC client material at rest. Losing
# it makes every registered credential unreadable, which is the single strongest
# argument for the sops+age work - it used to exist only on one unbacked-up SSD.
#
# Image:  https://github.com/pocket-id/pocket-id/pkgs/container/pocket-id
# See:    https://pocket-id.org/docs/configuration/environment-variables
# ==============================================================================

[Unit]
Description=Pocket ID

# A UNIT THAT CANNOT START MUST EVENTUALLY SAY SO. Restart=always with
# RestartSec=5 spaces attempts ~5s apart, and systemd's shipped ceiling is 5
# starts in 10s - arithmetically unreachable at that spacing, so no quadlet here
# could ever exhaust it. During the 2026-08-19 outage this unit restarted 6,224
# times between 00:20 and 09:55 and never settled: it oscillated between failed
# and activating for nine and a half hours, burning CPU and journal, because
# nothing told it to stop.
#
# THIS IS NOT A DETECTION FIX AND MUST NOT BE SOLD AS ONE. containers.failed_units
# and containers.units_active both caught that outage within the hour and stayed
# FAIL throughout. What this buys is a unit that comes to REST in `failed` instead
# of flickering, which is what makes home_server_unit_state worth reading at all,
# and an end to an unbounded retry loop nobody was waiting on.
#
# 20 attempts in 600s = ~100 seconds of trying before it gives up, so a service
# waiting on a slow dependency at boot still recovers on its own while a hopeless
# one stops. Note the consequence: once tripped, `systemctl --user start` refuses
# until the interval lapses or you run `systemctl --user reset-failed <unit>`.
StartLimitIntervalSec=600
StartLimitBurst=20

[Container]
# :v2, and emphatically NOT :v1 - that tag is the 1.x line, so it would be a
# major DOWNGRADE of the service that gates sign-on for everything here.
# Pinning the major means a breaking release cannot close every UI at once
# overnight; moving to :v3 will be a deliberate act with a passkey login to
# prove it afterwards.
Image=ghcr.io/pocket-id/pocket-id:v2
AutoUpdate=registry
ContainerName=pocket-id
Network=net-ingress.network

# NoNewPrivileges is free here and is measured rather than assumed: nothing in
# this image needs to gain privileges through a setuid binary. A capability set
# is the next step and needs the same per-container test - DropCapability=ALL is
# NOT safe by default, and the two counter-examples are in this repository:
# caddy exits without NET_BIND_SERVICE, and every LinuxServer image needs five
# capabilities before s6-overlay will start at all.
NoNewPrivileges=true

Volume=${DOCKER_VOLUME_CONFIG}/pocket-id:/app/data:Z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=APP_URL=${POCKETID_APP_URL}
# The subnet Caddy actually addresses it on. Wrong value here and every request
# is attributed to the proxy instead of the client.
Environment=TRUST_PROXY=${NET_SUBNET_INGRESS}
Environment=ENCRYPTION_KEY=${POCKETID_ENCRYPTION_KEY}

# The image's OWN healthcheck, not curl, and that is not a style preference.
# 2.14.0 removed curl from its Dockerfile, so this probe - unchanged, and passing
# for twelve days - silently became a dependency on a binary that no longer
# existed. It exited 127 against an application that was up and serving: the
# startup gate below burned all 60 retries, Notify=healthy never fired, systemd
# killed the unit, and podman-auto-update rolled the image back to 2.13.0 - which
# could then no longer open the database 2.14.0 had just migrated. Nine and a half
# hours with no sign-on anywhere in the stack, from a probe that was measuring
# curl rather than Pocket ID. The image has declared this command all along:
#   HEALTHCHECK CMD ["/app/pocket-id", "healthcheck"]
# Same shape as gluetun.container, and the same lesson collect-metrics.py's
# api_get already carries about images that ship only wget.
#
# THE GATE BELOW IS 900s AND NOT 300s, AND THAT IS A PRECAUTION RATHER THAN A
# FIX FOR THE ABOVE. Nothing on 2026-08-19 was slow: 2.14.0 migrated, logged
# `Server listening` and was serving well inside the budget. The probe simply
# could not measure it, and the fix for that is the line below this comment.
#
# What the incident DID expose is that the gate protecting a service which
# migrates on start had never been sized against anything. Every quadlet carried
# the same 5s x 60, chosen once for start-up latency, and the consequence of it
# expiring is not "the unit restarts" - it is the deadlock in docs/known-state.md:
# the migration has already run, so restoring the old image restores something
# that cannot open its own database, and no restart ever clears it. A cold start
# with no migration is ~1s here, so the extra budget costs nothing in normal use
# and exists entirely for the one start after an image bump. See
# sonarr.container for the list of ten and why only they get it.
#
# IF THE DEADLOCK EVER HAPPENS, THE ROLLBACK IS NOT THE REPAIR - the database is,
# and the way out is FORWARD to the version matching the schema, never back.
# bin/pre-update-snapshot.sh takes the restore point as ExecStartPre= on
# podman-auto-update.service, ~21 hours newer than the 03:00 backup:
#   systemctl --user stop pocket-id
#   cp ~/.cache/home-server/pre-update-db/pocket-id/pocket-id.db \
#      ${DOCKER_VOLUME_CONFIG}/pocket-id/pocket-id.db
#   systemctl --user start pocket-id
# Re-pulling the NEWER image is usually faster and is the same idea: the schema
# it refuses to downgrade to is the one it wrote itself.
HealthCmd=/app/pocket-id healthcheck
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
# See sonarr.container. Tinyauth is ordered after this one, and Caddy after
# that, so this unit's start time is the head of the sign-on chain at boot.
HealthStartupCmd=/app/pocket-id healthcheck
HealthStartupInterval=5s
HealthStartupRetries=180
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# Must clear the startup check's 900s ceiling - see sonarr.container.
TimeoutStartSec=1200

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
