# ==============================================================================
# Pocket ID: passkey-only OpenID Connect provider
# ------------------------------------------------------------------------------
# There are no passwords to phish, leak or rotate - authentication is a WebAuthn
# signature from a device the user already carries.
#
# It is only a provider: it has no forward-auth endpoint, which is what Tinyauth
# is for. Applications that speak OIDC natively can point straight here.
#
# Alone with Caddy and Tinyauth on net-ingress, and publishes no port. It is
# reached only through Caddy, which is also what gives it the HTTPS that
# WebAuthn refuses to work without.
#
# APP_URL must match the browser's origin EXACTLY, port included. WebAuthn
# strips the port when deriving the relying-party ID, but the server validates
# the full origin string separately, and a mismatch fails registration at the
# last step with an unhelpful "couldn't process the response from your passkey".
#
# ENCRYPTION_KEY protects the passkey and OIDC client material at rest. Losing
# it makes every registered credential unreadable, which is the single strongest
# argument for the sops+age work - it used to exist only on one unbacked-up SSD.
#
# Image:  https://github.com/pocket-id/pocket-id/pkgs/container/pocket-id
# See:    https://pocket-id.org/docs/configuration/environment-variables
# ==============================================================================

[Unit]
Description=Pocket ID

[Container]
# :v2, and emphatically NOT :v1 - that tag is the 1.x line, so it would be a
# major DOWNGRADE of the service that gates sign-on for everything here.
# Pinning the major means a breaking release cannot close every UI at once
# overnight; moving to :v3 will be a deliberate act with a passkey login to
# prove it afterwards.
Image=ghcr.io/pocket-id/pocket-id:v2
AutoUpdate=registry
ContainerName=pocket-id
Network=net-ingress.network

Volume=${DOCKER_VOLUME_CONFIG}/pocket-id:/app/data:Z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=APP_URL=${POCKETID_APP_URL}
# The subnet Caddy actually addresses it on. Wrong value here and every request
# is attributed to the proxy instead of the client.
Environment=TRUST_PROXY=${NET_SUBNET_INGRESS}
Environment=ENCRYPTION_KEY=${POCKETID_ENCRYPTION_KEY}

HealthCmd=curl -fsS http://localhost:1411/healthz || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
