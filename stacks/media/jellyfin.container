# ==============================================================================
# Jellyfin: media server
# ------------------------------------------------------------------------------
# The most exposed service here - reachable from the LAN directly and from the
# internet through Caddy - and yet it initiates no internal connections at all.
# That asymmetry is what lets net-media be this small: only Jellyseerr reads
# from it, and it reads from nothing.
#
# The published port is one of only two in the stack. LAN clients (TVs, the
# Jellyfin apps) connect straight to it rather than through the proxy, and it is
# deliberately NOT behind single sign-on because those clients have no browser
# in which to complete a passkey prompt. Jellyfin authenticates its own users.
#
# GPU: `deploy.resources.reservations` with count:1 became an explicit CDI
# reference. count:1 meant "the first device", which is GPU 0 - the same one
# tdarr-node-01 uses. Two RTX 3060 Ti, and NVIDIA's consumer NVENC limit has
# been 8 concurrent sessions since Jan 2024, so sharing is not a constraint.
#
# Image:  https://docs.linuxserver.io/images/docker-jellyfin
# See:    https://jellyfin.org/docs/general/administration/hardware-acceleration/
# ==============================================================================

[Unit]
Description=Jellyfin

[Container]
Image=lscr.io/linuxserver/jellyfin:latest
AutoUpdate=registry
ContainerName=jellyfin
Network=net-media.network

AddDevice=/dev/dri
# GPU 1, BECAUSE GPU 0's VIDEO ENGINES ARE DEAD. Both cards are RTX 3060 Ti on
# the same VBIOS, but on GPU 0 (PCI 01:00.0, serial ...6697) every NVENC session
# fails with "OpenEncodeSessionEx failed: unsupported device" and every NVDEC
# init fails with CUDA_ERROR_NO_DEVICE. CUDA compute on that card is fine; only
# the dedicated video block is gone. Reproduced 3/3 against GPU 1 passing in the
# same loop, on two driver versions and two driver flavours, rootless and
# rootful. It is a hardware fault, not configuration.
#
# This cost hours, because nvidia-smi reports the card as perfectly healthy and
# `ffmpeg -encoders` lists hevc_nvenc regardless - neither proves an encode
# session can be opened. **Test a real encode against a specific card index;
# nothing else tells you the truth.**
AddDevice=nvidia.com/gpu=1

Volume=${DOCKER_VOLUME_CONFIG}/jellyfin:/config:Z
Volume=${DOCKER_VOLUME_MEDIA}/library:/data/media

PublishPort=${BIND_LAN}:${PORT_JELLYFIN_WEB}:8096

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}

HealthCmd=curl -fsS http://localhost:8096/health || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=90s
HealthRetries=3
# See sonarr.container. Jellyfin is the slowest of the *arr-shaped starts, which
# is exactly why the startup check earns its place here.
HealthStartupCmd=curl -fsS http://localhost:8096/health || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/media-stack/.env

# The web UI's Custom CSS is TRACKED IN GIT at apps/jellyfin/custom.css and
# rendered into config/jellyfin/branding.xml on every start. Same contract as
# Tdarr's plugins and Sonarr's scripts: git is authoritative.
#
# WHICH MEANS A CUSTOM CSS EDIT MADE IN JELLYFIN'S UI IS TEMPORARY. It survives
# until the next restart, and podman-auto-update restarts this nightly, so it
# will silently revert. Edit the file in git instead.
#
# The renderer replaces ONLY the CustomCss element and preserves the rest of the
# document, because LoginDisclaimer and SplashscreenEnabled live there too and
# are genuinely the UI's to own.
#
# Leading `-` so a failure cannot stop Jellyfin. This is cosmetics; it must
# never be able to take the media server down. It logs to the journal instead.
ExecStartPre=-/var/media-stack/bin/render-jellyfin-branding.py

Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=default.target
