# ==============================================================================
# Tdarr server: transcode orchestrator
# ------------------------------------------------------------------------------
# Hands work to the node, which connects out to it. It initiates nothing towards
# anything, so net-transcode holds only these two and Caddy.
#
# ORCHESTRATOR ONLY - internalNode=false, and it stays that way. Tdarr can run
# an internal node and collapse to a single container, but separate containers
# mean separate cgroups, and that separation is the only reason the throttling
# works: the worker is the thing that must be starved, while this process serves
# the API that bin/promote-transcoded.py depends on and owns the SQLite database
# that an OOM kill must not land on mid-write.
#
# The scratch mount is DELIBERATELY not under the media disk, and that matters
# more than it looks: sda is a Seagate ST8000DM004, a SHINGLED (SMR) drive whose
# sustained writes stall for seconds at a time. Keeping the cache on the SSD
# leaves only the final, sequential output write on the shingled disk.
#
# Image:  https://github.com/users/haveagitgat/packages/container/package/tdarr
# See:    https://docs.tdarr.io/docs/installation/docker/run-compose
# ==============================================================================

[Unit]
Description=Tdarr server

[Container]
# Server and node MUST move together - a node refuses to register with a server
# of a different version. Both track :latest so one auto-update run moves the
# pair; if one ever rolls back and the other does not, transcoding stops with
# both containers reporting healthy.
Image=ghcr.io/haveagitgat/tdarr:latest
AutoUpdate=registry
ContainerName=tdarr-server
Network=net-transcode.network

Volume=${DOCKER_VOLUME_CONFIG}/tdarr/server:/app/server:Z
# configs/ and logs/ are shared with both nodes, so :z (shared) not :Z (private).
# A private label here would make them unreadable to the nodes.
Volume=${DOCKER_VOLUME_CONFIG}/tdarr/configs:/app/configs:z
Volume=${DOCKER_VOLUME_CONFIG}/tdarr/logs:/app/logs:z
Volume=${DOCKER_VOLUME_CACHE}/tdarr:/temp:z
Volume=${DOCKER_VOLUME_MEDIA}:/media

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}
Environment=internalNode=false
Environment=nodeID=TdarrServer

HealthCmd=curl -fsS http://localhost:8266/api/v2/status || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=90s
HealthRetries=3
# See sonarr.container.
HealthStartupCmd=curl -fsS http://localhost:8266/api/v2/status || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/media-stack/.env
# Podman does not create a missing bind-mount source directory; Docker did.
# The difference surfaces as
#   Error: statfs /var/media-stack/config/tdarr/logs: no such file or directory
# and with Restart=always it becomes a silent 5-second retry loop rather than a
# visible failure - this unit reached restart 126 before anyone looked. These
# are all scratch or log paths that no backup restores, so a fresh host has
# none of them.
ExecStartPre=/usr/bin/mkdir -p ${DOCKER_VOLUME_CONFIG}/tdarr/server ${DOCKER_VOLUME_CONFIG}/tdarr/configs ${DOCKER_VOLUME_CONFIG}/tdarr/logs ${DOCKER_VOLUME_CACHE}/tdarr ${DOCKER_VOLUME_CONFIG}/tdarr/server/Tdarr/Plugins/Local
# Local plugins are TRACKED IN GIT at apps/tdarr/plugins/ and copied in on every
# start, because everything under config/ is gitignored runtime state. The copy
# is authoritative-from-git: editing the one in Plugins/Local/ on the server is
# pointless, it is overwritten here. The trailing /. copies the directory
# CONTENTS - systemd runs this without a shell, so a glob would not expand.
ExecStartPre=/usr/bin/cp -a /var/media-stack/apps/tdarr/plugins/. ${DOCKER_VOLUME_CONFIG}/tdarr/server/Tdarr/Plugins/Local/
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# ------------------------------------------------------------------------------
# Resource limits - added after this unit took the whole host down
# ------------------------------------------------------------------------------
# Moving 470 episodes into a watched folder queued 470 Tdarr jobs. A Tdarr health
# check is a FULL-FILE DECODE, not a metadata read, so that is the entire library
# read end to end off one 7200rpm spindle, with six libraries scanning at once.
# The machine stayed up at the kernel level - it answered ICMP and completed TCP
# handshakes the whole time - while no userspace process could be scheduled:
# sshd never got far enough to send a banner, and Caddy and Jellyfin answered
# nothing. It needed a power cycle.
#
# These are systemd cgroup v2 controls rather than podman flags, because a
# quadlet IS a systemd unit and this is the layer that can actually starve it.
# Transcoding is batch work with no deadline, so under contention it should lose
# to everything else - that is what the weights say. The point is not to make
# Tdarr fast; it is to make Tdarr incapable of taking the host with it.
#
# NOTE: CPUWeight and IOWeight need the cpu and io controllers DELEGATED to the
# user manager. memory and pids are delegated by default, io is NOT, and an
# undelegated controller fails SILENTLY - the directive is accepted and does
# nothing, which is how every IOWeight here was inert for its first day.
# host/butane/ucore.bu ships the drop-in that fixes it. Verify, do not assume:
#   systemctl show user@1000.service -p DelegateControllers
#
# These weights are only half of it. The other half is Tdarr's OWN limits, which
# live in its database rather than here: worker counts (2 GPU transcode, 1 CPU
# transcode, 1 GPU health check) and scannerThreadCount=1. Ten concurrent ffmpeg
# processes were what the six-thread machine actually died of.
CPUWeight=20
IOWeight=20
MemoryHigh=2G
MemoryMax=3G

[Install]
WantedBy=default.target
