# ==============================================================================
# Bazarr: subtitle manager
# ------------------------------------------------------------------------------
# Nothing in this stack fetched subtitles before it. Jellyfin's Open Subtitles
# plugin was installed and fully credentialed but every library had
# EnableInternetProviders=false, so it never ran - and the Tdarr flow was
# actively destroying the embedded subtitle tracks that did exist.
#
# net-arr ONLY. It talks to radarr:7878 and sonarr:8989 by container name and to
# subtitle providers on the internet; it needs nothing else. It deliberately
# does NOT join net-media - Jellyfin reads the .srt sidecars off the filesystem,
# so the two never speak.
#
# NO PATH MAPPING TO MAINTAIN. Bazarr reads each item's path from Radarr and
# Sonarr, and bin/promote-transcoded.py keeps those pointing at whichever of
# queued/ or transcoded/ the file actually occupies. So Bazarr follows the file
# through the pipeline on its own. This is why /data is mounted at the same
# path the *arr apps use, and why mounting only library/ would break it.
#
# Sidecars, not embedded. Muxing subtitles into the MKV would mean a remux on
# every subtitle upgrade and would put Bazarr's sync/fix tooling out of reach.
#
# Image:  https://docs.linuxserver.io/images/docker-bazarr
# ==============================================================================

[Unit]
Description=Bazarr

[Container]
Image=lscr.io/linuxserver/bazarr:latest
AutoUpdate=registry
ContainerName=bazarr
Network=net-arr.network

# MEASURED ON 2026-08-19, NOT ASSUMED, and the bare form does not work.
# DropCapability=ALL on its own breaks every LinuxServer image outright:
# s6-overlay cannot complete its init without these five, and the container
# never answers. With them it starts clean and still gives up the other nine
# defaults - NET_RAW, MKNOD, SYS_CHROOT, SETPCAP, SETFCAP, KILL, AUDIT_WRITE,
# FSETID and NET_BIND_SERVICE. Proven against radarr and against jellyfin,
# which keeps its GPU through the CDI device with every one of those dropped.
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
NoNewPrivileges=true

Volume=${DOCKER_VOLUME_CONFIG}/bazarr:/config:Z
Volume=${DOCKER_VOLUME_MEDIA}:/data

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}

# No PublishPort. Caddy reaches it by name over net-arr; an admin port would be
# a second way in that single sign-on does not cover.
HealthCmd=curl -fsS http://localhost:6767/ || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=90s
HealthRetries=3
# See sonarr.container: this is the unit the 65s -> 20s figure was measured on.
HealthStartupCmd=curl -fsS http://localhost:6767/ || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
# Podman does not create a missing bind-mount source directory; Docker did.
ExecStartPre=/usr/bin/mkdir -p ${DOCKER_VOLUME_CONFIG}/bazarr
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob. Bazarr's subtitle sync can spike, so it gets a
# little more headroom than the *arr apps.
MemoryHigh=1536M
MemoryMax=2G

[Install]
WantedBy=default.target
