# ==============================================================================
# Sonarr: TV shows library manager
# ------------------------------------------------------------------------------
# On net-arr to be reached by Caddy and to be polled by Unpackerr and
# Jellyseerr, and on net-download to push releases to qBittorrent - which it
# addresses as gluetun:${PORT_QBITTORRENT_WEB}, since the downloader has no name
# of its own.
#
# It reaches its indexers through Prowlarr on net-arr; the 30-odd Torznab
# entries in its database all point at http://prowlarr:9696/<id>/.
#
# Image:  https://docs.linuxserver.io/images/docker-sonarr
# ==============================================================================

[Unit]
Description=Sonarr

[Container]
Image=lscr.io/linuxserver/sonarr@sha256:bed3afb5d46fde809290997760f2e19d41e57d1eb34f507c485d5a8979c7cd8d
ContainerName=sonarr
Network=net-arr.network
Network=net-download.network

Volume=${DOCKER_VOLUME_CONFIG}/sonarr:/config:Z
# One mount, not several: downloads/ and library/ must stay on one filesystem so
# imports can hardlink instead of copying. No :z - see stacks/README.md.
Volume=${DOCKER_VOLUME_MEDIA}:/data

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=DOCKER_MODS=ghcr.io/gilbn/theme.park:sonarr
Environment=TP_THEME=${TP_THEME}

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
