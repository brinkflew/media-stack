# ==============================================================================
# Prowlarr: indexer manager and proxy
# ------------------------------------------------------------------------------
# The only service in three segments, and the reason each one is needed:
#   net-arr       syncs indexer definitions into Sonarr and Radarr, and proxies
#                 their Torznab queries back out
#   net-download  tests and pushes to qBittorrent at gluetun:8200
#   net-solver    the sole consumer of FlareSolverr
#
# That makes it the single hop between a compromised FlareSolverr and everything
# else, which is why its own login matters MORE than the others', not less. Do
# not set AuthenticationMethod=External here.
#
# Image:  https://docs.linuxserver.io/images/docker-prowlarr
# ==============================================================================

[Unit]
Description=Prowlarr

[Container]
Image=lscr.io/linuxserver/prowlarr@sha256:1776ab8b030fdb198e7e2dae407a01b06c14360e9fb95f459c7e38914026da79
ContainerName=prowlarr
Network=net-arr.network
Network=net-download.network
Network=net-solver.network

# NOT THE ISP'S RESOLVER. Several indexer domains are DNS-blocked upstream: all
# three distinct 1337x hostnames resolved to one address, 193.191.210.104, which
# is a blocking page rather than the site. Four indexers failed as "DNS/SSL
# issues" and the containers looked perfectly healthy throughout.
#
# Measured, not assumed: the same request that dies at the sinkhole reaches the
# real Cloudflare-fronted host and returns a 403 challenge when resolved here -
# and a challenge is what FlareSolverr on net-solver exists to solve.
DNS=9.9.9.9
DNS=1.1.1.1

Volume=${DOCKER_VOLUME_CONFIG}/prowlarr:/config:Z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=DOCKER_MODS=ghcr.io/gilbn/theme.park:prowlarr
Environment=TP_THEME=${TP_THEME}
Environment=TP_COMMUNITY_THEME=${TP_COMMUNITY_THEME}

HealthCmd=curl -fsS http://localhost:9696/ping || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=1G
MemoryMax=1536M

[Install]
WantedBy=default.target
