# ==============================================================================
# FlareSolverr: Cloudflare / DDoS-GUARD bypass
# ------------------------------------------------------------------------------
# Renders indexer pages in a real headless Chrome, which makes this the most
# likely container in the stack to be compromised: its entire input is
# attacker-controlled HTML and JavaScript from sites nobody vets.
#
# It is therefore alone on net-solver with Prowlarr. It still reaches the
# internet - every bridge NATs out - but from inside it, nothing else in the
# stack resolves or answers. Verified by TCP connect, not only by name
# resolution: a container has one address per network it joins, so proving the
# name does not resolve proves less than it appears to.
#
# DO NOT add another network here, and do not give Caddy a leg into net-solver.
# There is no UI worth exposing.
#
# Image:  https://hub.docker.com/r/flaresolverr/flaresolverr
# See:    https://github.com/FlareSolverr/FlareSolverr
# ==============================================================================

[Unit]
Description=FlareSolverr

[Container]
# Update this one EAGERLY. It runs attacker-controlled JavaScript in headless
# Chrome by design, so it is the single image here whose staleness is a
# security cost rather than a stability benefit.
Image=ghcr.io/flaresolverr/flaresolverr:latest
AutoUpdate=registry
ContainerName=flaresolverr
Network=net-solver.network

# Same reason as prowlarr.container: this fetches the indexer pages itself, so
# resolving them through the ISP would land it on the same blocking page.
DNS=9.9.9.9
DNS=1.1.1.1

Environment=LOG_LEVEL=info
Environment=LOG_HTML=false
Environment=CAPTCHA_SOLVER=none
Environment=TZ=${TIMEZONE}

HealthCmd=curl -fsS http://localhost:8191/health || exit 1
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=60s
HealthRetries=3
# See sonarr.container. This is the image updated most eagerly, so it is also
# the one whose rollback gets exercised most.
HealthStartupCmd=curl -fsS http://localhost:8191/health || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=default.target
