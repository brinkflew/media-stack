# ==============================================================================
# Radarr: movie library manager
# ------------------------------------------------------------------------------
# Same shape as Sonarr: net-arr for Caddy, Unpackerr and Jellyseerr, and
# net-download to reach qBittorrent at gluetun:${PORT_QBITTORRENT_WEB}.
#
# Image:  https://docs.linuxserver.io/images/docker-radarr
# ==============================================================================

[Unit]
Description=Radarr

[Container]
Image=lscr.io/linuxserver/radarr@sha256:659e5f20500948b1491f31dd85c6f99a43508ce3e46595793e1e15aa955bf6d7
ContainerName=radarr
Network=net-arr.network
Network=net-download.network

Volume=${DOCKER_VOLUME_CONFIG}/radarr:/config:Z
Volume=${DOCKER_VOLUME_MEDIA}:/data

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=DOCKER_MODS=ghcr.io/gilbn/theme.park:radarr
Environment=TP_THEME=${TP_THEME}
Environment=TP_COMMUNITY_THEME=${TP_COMMUNITY_THEME}

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
