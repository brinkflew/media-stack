# ==============================================================================
# Radarr: movie library manager
# ------------------------------------------------------------------------------
# Same shape as Sonarr: net-arr for Caddy, Unpackerr and Jellyseerr, and
# net-download to reach qBittorrent at gluetun:${PORT_QBITTORRENT_WEB}.
#
# Image:  https://docs.linuxserver.io/images/docker-radarr
# ==============================================================================

[Unit]
Description=Radarr

[Container]
Image=lscr.io/linuxserver/radarr:latest
AutoUpdate=registry
ContainerName=radarr
Network=net-arr.network
Network=net-download.network

# MEASURED ON 2026-08-19, NOT ASSUMED, and the bare form does not work.
# DropCapability=ALL on its own breaks every LinuxServer image outright:
# s6-overlay cannot complete its init without these five, and the container
# never answers. With them it starts clean and still gives up the other nine
# defaults - NET_RAW, MKNOD, SYS_CHROOT, SETPCAP, SETFCAP, KILL, AUDIT_WRITE,
# FSETID and NET_BIND_SERVICE. Proven against radarr and against jellyfin,
# which keeps its GPU through the CDI device with every one of those dropped.
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
NoNewPrivileges=true

Volume=${DOCKER_VOLUME_CONFIG}/radarr:/config:Z
Volume=${DOCKER_VOLUME_MEDIA}:/data

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=DOCKER_MODS=ghcr.io/gilbn/theme.park:radarr
Environment=TP_THEME=${TP_THEME}
Environment=TP_COMMUNITY_THEME=${TP_COMMUNITY_THEME}

HealthCmd=curl -fsS http://localhost:7878/ping || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
# See sonarr.container: the startup check makes Notify=healthy cost ~20s instead
# of ~65s, and Notify=healthy is what makes auto-update's rollback real.
HealthStartupCmd=curl -fsS http://localhost:7878/ping || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=1G
MemoryMax=1536M

[Install]
WantedBy=default.target
