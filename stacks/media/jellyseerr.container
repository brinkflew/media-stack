# ==============================================================================
# Jellyseerr: media request manager
# ------------------------------------------------------------------------------
# The one service that legitimately spans two segments: it reads the library
# from Jellyfin on net-media and files requests into Sonarr and Radarr on
# net-arr. Its stored settings address all three by container name.
#
# Public, like Jellyfin, and for the same reason: it authenticates its own users
# and its callers have no browser for a passkey prompt.
#
# Image:  https://hub.docker.com/r/fallenbagel/jellyseerr
# ==============================================================================

[Unit]
Description=Jellyseerr
After=jellyfin.service radarr.service sonarr.service

# See pocket-id.container: Restart=always at RestartSec=5 can never reach
# systemd's shipped 5-in-10s ceiling, so a hopeless unit loops for ever instead
# of coming to rest in `failed`.
StartLimitIntervalSec=600
StartLimitBurst=20

[Container]
# :2, not :latest, since 2026-08-19 - and it is the ONLY image here that could
# make that move. The doctrine is already written down in CLAUDE.md, where
# VictoriaMetrics was rejected as the metrics store precisely because it
# publishes no rolling major tag; eleven images here were tracking :latest in
# spite of it.
#
# Checked against each registry rather than assumed, and the answer was mostly
# no: flaresolverr, tdarr, tdarr_node and joal publish full version pins and
# :latest with nothing in between, ntfy-alertmanager publishes only :latest,
# and LinuxServer ships :latest as its stable channel alongside pins like
# 10.10.7ubu2404-ls88 - so for those the choice is a moving tag or a pin that
# nothing maintains, which is the trap digest pinning already fell into here.
#
# Which is why the rollback matters more than the tag: see
# host/systemd/podman-auto-update.service.d/20-snapshot-databases.conf.
Image=docker.io/fallenbagel/jellyseerr:2
AutoUpdate=registry
ContainerName=jellyseerr
Network=net-arr.network
Network=net-media.network

# NoNewPrivileges is free here and is measured rather than assumed: nothing in
# this image needs to gain privileges through a setuid binary. A capability set
# is the next step and needs the same per-container test - DropCapability=ALL is
# NOT safe by default, and the two counter-examples are in this repository:
# caddy exits without NET_BIND_SERVICE, and every LinuxServer image needs five
# capabilities before s6-overlay will start at all.
NoNewPrivileges=true

Volume=${DOCKER_VOLUME_CONFIG}/jellyseerr:/app/config:Z

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}

# wget, not curl - this image ships no curl.
HealthCmd=wget -qO- http://localhost:5055/api/v1/status || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
# See sonarr.container.
HealthStartupCmd=wget -qO- http://localhost:5055/api/v1/status || exit 1
HealthStartupInterval=5s
HealthStartupRetries=180
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# Must clear the startup check's 900s ceiling - see sonarr.container.
TimeoutStartSec=1200

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=1G
MemoryMax=1536M

[Install]
WantedBy=default.target
