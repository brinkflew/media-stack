# ==============================================================================
# Jellyseerr: media request manager
# ------------------------------------------------------------------------------
# The one service that legitimately spans two segments: it reads the library
# from Jellyfin on net-media and files requests into Sonarr and Radarr on
# net-arr. Its stored settings address all three by container name.
#
# Public, like Jellyfin, and for the same reason: it authenticates its own users
# and its callers have no browser for a passkey prompt.
#
# Image:  https://hub.docker.com/r/fallenbagel/jellyseerr
# ==============================================================================

[Unit]
Description=Jellyseerr
After=jellyfin.service radarr.service sonarr.service

[Container]
Image=docker.io/fallenbagel/jellyseerr:latest
AutoUpdate=registry
ContainerName=jellyseerr
Network=net-arr.network
Network=net-media.network

Volume=${DOCKER_VOLUME_CONFIG}/jellyseerr:/app/config:Z

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}

# wget, not curl - this image ships no curl.
HealthCmd=wget -qO- http://localhost:5055/api/v1/status || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
# See sonarr.container.
HealthStartupCmd=wget -qO- http://localhost:5055/api/v1/status || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/media-stack/.env
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=1G
MemoryMax=1536M

[Install]
WantedBy=default.target
