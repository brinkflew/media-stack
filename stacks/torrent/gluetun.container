# ==============================================================================
# Gluetun: VPN client and egress chokepoint
# ------------------------------------------------------------------------------
# Holds the network namespace that qBittorrent and JOAL live in. Everything they
# send leaves through the tunnel or not at all.
#
# Notify=healthy is what makes this safe. Podman withholds systemd's READY
# signal until the container's healthcheck passes, so the members that
# Requires= this unit cannot start into a namespace whose only route is the
# bare bridge. Compose expressed the same thing as
# `depends_on: gluetun: condition: service_healthy`.
#
# ROOTLESS NOTES, both untestable on the current host and to be verified on
# first boot after the migration:
#   - /dev/net/tun must be readable by the running user. CoreOS ships it 0600
#     root:root, so host/butane/ carries a udev rule.
#   - NET_ADMIN inside a user namespace is enough for gluetun to configure
#     WireGuard and its firewall; it does not need real root on the host.
#
# Image:  https://github.com/qdm12/gluetun/pkgs/container/gluetun
# See:    https://github.com/qdm12/gluetun/wiki
# ==============================================================================

[Unit]
Description=Gluetun VPN client
After=network-online.target

# See pocket-id.container: Restart=always at RestartSec=5 can never reach
# systemd's shipped 5-in-10s ceiling, so a hopeless unit loops for ever instead
# of coming to rest in `failed`.
StartLimitIntervalSec=600
StartLimitBurst=20

[Container]
# :v3 rather than :latest, because this container IS the kill-switch. qBittorrent
# and JOAL have no network stack of their own - they live in this pod's namespace
# - so a gluetun that fails to come up takes both down with it, by design. A v4
# arriving overnight is not a risk worth running for a container doing its job.
#
# This is also the one unit whose rollback already works properly: Notify=healthy
# means systemd does not consider it started until the tunnel is up, so a bad
# image fails the unit and podman auto-update puts the old one back.
Image=docker.io/qmcgaw/gluetun:v3
AutoUpdate=registry
ContainerName=gluetun
Pod=torrent.pod

AddCapability=NET_ADMIN
AddDevice=/dev/net/tun

Volume=${DOCKER_VOLUME_CONFIG}/gluetun:/gluetun:Z

Environment=PUID=0
Environment=PGID=0
Environment=TZ=${TIMEZONE}
Environment=FIREWALL_OUTBOUND_SUBNETS=${NET_LOCAL_SUBNET}

# Off. Both ran without credentials, which made them an open proxy into the VPN
# for anything on the LAN. If you want them back, set credentials at the same
# time.
Environment=HTTPPROXY=off
Environment=SHADOWSOCKS=off

# ProtonVPN over WireGuard. Gluetun ships every Proton server's public key,
# endpoint and tunnel address, so the private key is the only credential needed.
Environment=VPN_SERVICE_PROVIDER=${VPN_PROVIDER}
Environment=VPN_TYPE=${VPN_TYPE}
Environment=WIREGUARD_PRIVATE_KEY=${VPN_WG_PRIVATE_KEY}

# Port forwarding needs NAT-PMP ticked when the WireGuard config was generated;
# PORT_FORWARD_ONLY restricts server selection to nodes that support it.
Environment=VPN_PORT_FORWARDING=on
Environment=PORT_FORWARD_ONLY=on

# ProtonVPN hands out a different forwarded port on every reconnect while
# qBittorrent's listen port is static in its config. Left alone the two drift
# apart and no incoming peer can reach the client. qBittorrent shares this
# namespace, so 127.0.0.1 reaches it.
# QUOTED, and it must stay that way - see the note in tinyauth.container.
# Unquoted, quadlet passed gluetun a bare "/bin/sh" and dropped the rest, so
# every reconnect forwarded a port that was never pushed to qBittorrent. The
# VPN stays up and the client just goes unconnectable.
Environment="VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'wget -qO- --retry-connrefused --post-data=\"json={\\\"listen_port\\\":{{PORTS}}}\" http://127.0.0.1:${PORT_QBITTORRENT_WEB}/api/v2/app/setPreferences'"

Environment=SERVER_CITIES=${VPN_SERVER_CITIES}
Environment=SERVER_COUNTRIES=${VPN_SERVER_COUNTRIES}
Environment=SERVER_HOSTNAMES=${VPN_SERVER_HOSTS}
Environment=SERVER_REGIONS=${VPN_SERVER_REGION}

# Optional overrides, all empty in practice. Carried over from the Compose file
# rather than dropped, so that pinning a specific server or falling back to
# OpenVPN stays a change to .env rather than a change to this unit.
Environment=VPN_ENDPOINT_IP=${VPN_WG_ENDPOINT_ADDR}
Environment=VPN_ENDPOINT_PORT=${VPN_WG_ENDPOINT_PORT}
Environment=WIREGUARD_ADDRESSES=${VPN_WG_ADDRESSES}
Environment=WIREGUARD_PRESHARED_KEY=${VPN_WG_PRESHARED_KEY}
Environment=WIREGUARD_PUBLIC_KEY=${VPN_WG_PUBLIC_KEY}
Environment=OPENVPN_CUSTOM_CONFIG=${VPN_OPENVPN_CONFIG}
Environment=OPENVPN_USER=${VPN_USERNAME}
Environment=OPENVPN_PASSWORD=${VPN_PASSWORD}

HealthCmd=/gluetun-entrypoint healthcheck
HealthInterval=5s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=1
# NO HealthStartupCmd here, deliberately - do not "fix" the inconsistency with
# the other units. A startup check exists to stop Notify=healthy waiting a full
# HealthInterval before the first probe; this interval is already 5s, because
# gluetun is the kill-switch and a dead tunnel must be noticed immediately. It
# has nothing to gain.
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# The tunnel handshake plus the first healthcheck can outlast the default 90s
# on a cold start, and a timeout here cascades into both downloaders.
TimeoutStartSec=300

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=default.target
