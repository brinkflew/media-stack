# ==============================================================================
# JOAL: torrent fake-upload client
# ------------------------------------------------------------------------------
# In the VPN namespace for the same reason qBittorrent is: it announces to
# trackers, and on the shared bridge those announces carried the host's own IP
# while qBittorrent's went through ProtonVPN.
#
# Like qBittorrent it has no name of its own, so Caddy reaches its UI at
# gluetun:${PORT_JOAL_WEB}. Forgetting that is what broke the fakerr route when
# it first moved into the namespace.
#
# Image:  https://hub.docker.com/r/anthonyraymond/joal
# See:    https://github.com/anthonyraymond/joal
# ==============================================================================

[Unit]
Description=JOAL
Requires=gluetun.service
After=gluetun.service
# See qbittorrent.container: Requires= propagates a stop but not a restart, so
# without this a restart of gluetun leaves JOAL down - announcing nothing, with
# nothing obviously wrong.
PartOf=gluetun.service

# See pocket-id.container: Restart=always at RestartSec=5 can never reach
# systemd's shipped 5-in-10s ceiling, so a hopeless unit loops for ever instead
# of coming to rest in `failed`.
StartLimitIntervalSec=600
StartLimitBurst=20

[Container]
Image=docker.io/anthonyraymond/joal:latest
AutoUpdate=registry
ContainerName=joal
Pod=torrent.pod

# NoNewPrivileges is free here and is measured rather than assumed: nothing in
# this image needs to gain privileges through a setuid binary. A capability set
# is the next step and needs the same per-container test - DropCapability=ALL is
# NOT safe by default, and the two counter-examples are in this repository:
# caddy exits without NET_BIND_SERVICE, and every LinuxServer image needs five
# capabilities before s6-overlay will start at all.
NoNewPrivileges=true

Volume=${DOCKER_VOLUME_CONFIG}/joal:/config:Z
Volume=${DOCKER_VOLUME_MEDIA}/downloads/faking:/config/torrents

Environment=PUID=0
Environment=PGID=0
Environment=UMASK=${UMASK}
Environment=TZ=${TIMEZONE}

# Exec= is the container's command, the equivalent of Compose's `command:`.
# The UI is served under a secret path prefix with a token behind it; both come
# from the environment so neither ends up in this public repository.
Exec=--joal-conf=/config --spring.main.web-environment=true --server.port=${PORT_JOAL_WEB} --joal.ui.path.prefix=${JOAL_OBFUSCATION_PATH} --joal.ui.secret-token=${JOAL_SECRET_TOKEN}

# No -f: JOAL serves its UI under a secret path and answers 404 on /, so a
# status check would fail on a perfectly healthy process. Any HTTP response at
# all proves the listener is up, which is what this is for.
HealthCmd=curl -s -o /dev/null --max-time 5 http://localhost:${PORT_JOAL_WEB}/ || exit 1
HealthInterval=60s
HealthTimeout=10s
HealthStartPeriod=60s
HealthRetries=3
# See sonarr.container.
HealthStartupCmd=curl -s -o /dev/null --max-time 5 http://localhost:${PORT_JOAL_WEB}/ || exit 1
HealthStartupInterval=5s
HealthStartupRetries=60
HealthStartupSuccess=1
Notify=healthy

[Service]
EnvironmentFile=/var/home-server/.env
Restart=always
RestartSec=5
# Must clear the startup check's 300s ceiling - see sonarr.container.
TimeoutStartSec=360

# A ceiling, not a tuning knob: high enough never to bite in normal use,
# low enough that a runaway is killed instead of taking the host down.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
