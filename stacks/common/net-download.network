# ==============================================================================
# net-download
# ------------------------------------------------------------------------------
# Everything that talks to qBittorrent's API. The torrent pod owns this network; its member containers inherit it and must not declare one.
#
# Transcribed from the Compose topology this replaces, which is running and
# verified - not a fresh design. Podman creates the network with --ignore, so
# starting an already-created network is a no-op, but CHANGING a subnet is not:
# the network has to be removed while nothing is attached to it.
# ==============================================================================

[Network]
NetworkName=net-download
Subnet=${NET_SUBNET_DOWNLOAD}

# Quadlet passes [Service] through to the generated unit, and without this the
# Subnet= above expands to an EMPTY STRING rather than failing: systemd logs
# "Referenced but unset environment variable" at info level and podman then
# rejects it with "Error: invalid CIDR address:" - a message that says nothing
# about which variable, or that a file was never read.
#
# The .container units all carry this line; the .network units did not, so the
# whole stack failed at its first dependency. Every quadlet that interpolates a
# variable needs it, whatever its type.
[Service]
EnvironmentFile=/var/media-stack/.env
