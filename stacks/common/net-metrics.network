# ==============================================================================
# net-metrics
# ------------------------------------------------------------------------------
# Prometheus and the two exporters that describe the machine rather than any one application. Caddy joins it so the query API is reachable from a browser.
#
# The eighth segment, and the first one added since the migration. It exists so
# that the collector does NOT become a hub: the obvious metrics design puts an
# exporter for each application on both this network and that application's own,
# which would leave net-metrics adjoining net-arr, net-download, net-media and
# net-transcode at once - re-flattening the topology that Options=isolate=true
# was added to restore.
#
# The inversion is the design: PROMETHEUS multi-homes, exporters never do. When
# the application segments are added it joins them as a pure client, with its
# listener pinned to its address on THIS network, so nothing on net-arr can
# open a connection to it. That is the same argument caddy.container makes for
# its five memberships, with one container to harden instead of eight.
#
# Members: prometheus, node-exporter, cadvisor, caddy. Nothing else belongs
# here - an application that wants to be measured is measured from outside it.
# ==============================================================================

[Network]
NetworkName=net-metrics
Subnet=${NET_SUBNET_METRICS}
# Isolation is NOT free under Podman. Docker put every bridge in
# DOCKER-ISOLATION-STAGE-2 and dropped traffic between them, which is what made
# "no shared network means no route" true. Netavark does no such thing: with
# these networks created plain, a container on net-solver reached sonarr on
# net-arr by IP, and so did net-media, net-egress and net-transcode. The
# topology looked segmented and was flat.
#
# --opt isolate=true restores it. Verified on this host before adopting: with it
# set, same-network traffic still passes and every other bridge is dropped.
# It does not constrain a container that JOINS several networks - caddy still
# reaches each segment it is a member of.
Options=isolate=true

# Quadlet passes [Service] through to the generated unit, and without this the
# Subnet= above expands to an EMPTY STRING rather than failing: systemd logs
# "Referenced but unset environment variable" at info level and podman then
# rejects it with "Error: invalid CIDR address:" - a message that says nothing
# about which variable, or that a file was never read.
#
# The .container units all carry this line; the .network units did not, so the
# whole stack failed at its first dependency. Every quadlet that interpolates a
# variable needs it, whatever its type.
[Service]
EnvironmentFile=/var/home-server/.env
