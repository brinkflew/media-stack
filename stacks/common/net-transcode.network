# ==============================================================================
# net-transcode
# ------------------------------------------------------------------------------
# The Tdarr server and its two nodes. The nodes connect out to the server and to nothing else.
#
# Transcribed from the Compose topology this replaces, which is running and
# verified - not a fresh design. Podman creates the network with --ignore, so
# starting an already-created network is a no-op, but CHANGING a subnet is not:
# the network has to be removed while nothing is attached to it.
# ==============================================================================

[Network]
NetworkName=net-transcode
Subnet=${NET_SUBNET_TRANSCODE}
