  "systemd": {
    "units": [
      {
        "enabled": false,
        "mask": true,
        "name": "zincati.service"
      },
      {
        "enabled": false,
        "mask": true,
        "name": "bootc-fetch-apply-updates.timer"
      },
      {
        "enabled": true,
        "name": "rpm-ostreed-automatic.timer"
      },
      {
        "contents": "[Unit]\nDescription=Media library (XFS on vg_xfs_media/xfs_db)\nBefore=local-fs.target\n# LVM must be assembled before this device node exists.\nRequires=lvm2-monitor.service\nAfter=lvm2-monitor.service\n\n[Mount]\nWhat=/dev/disk/by-uuid/fce53d5f-0849-40dd-81aa-ba21819c7eeb\nWhere=/var/mnt/media\nType=xfs\nOptions=rw,relatime,noquota,context=system_u:object_r:container_file_t:s0\n\n[Install]\nWantedBy=local-fs.target\n",
        "enabled": true,
        "name": "var-mnt-media.mount"
      },
      {
        "contents": "[Unit]\nDescription=Enable lingering for the service user\nAfter=systemd-user-sessions.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/loginctl enable-linger core\n# Ignition creates the parent directories for the symlinks above. It\n# applies the declared ownership to them, but this costs nothing and\n# runs in a fully booted system where /var/home/core certainly exists -\n# whereas a root-owned ~/.config breaks `systemctl --user` with a\n# permission error that reads as a Podman problem. Leading `-`: a\n# failure here must never propagate, because it is insurance, not a\n# dependency.\nExecStart=-/usr/bin/chown -R core:core /var/home/core/.config\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "enable-linger.service"
      },
      {
        "contents": "[Unit]\nDescription=Allow containers to use device nodes passed to them\nAfter=local-fs.target\nBefore=multi-user.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/sh -c 'getsebool container_use_devices | grep -q \" on$\" || setsebool -P container_use_devices 1'\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "selinux-container-devices.service"
      },
      {
        "contents": "[Unit]\nDescription=Open the host ports the stack publishes\nAfter=firewalld.service\nWants=firewalld.service\nBefore=multi-user.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\n# --permanent --add-* is idempotent; re-adding warns and exits 0.\nExecStart=/usr/bin/firewall-cmd --permanent --add-service=http\nExecStart=/usr/bin/firewall-cmd --permanent --add-service=https\nExecStart=/usr/bin/firewall-cmd --permanent --add-port=8096/tcp\nExecStart=/usr/bin/firewall-cmd --reload\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "firewall-stack-ports.service"
      }
    ]
  }
}
