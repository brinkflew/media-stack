variant: fcos
version: 1.5.0

# ==============================================================================
# uCore host definition
# ------------------------------------------------------------------------------
# Transpile with butane, then install with:
#
#   coreos-installer install /dev/nvme0n1 --ignition-file ucore.ign \
#     --image-url <ucore stable-nvidia oci>
#
# THE TARGET IS nvme0n1. /dev/sda carries the 8TB media library as an XFS
# filesystem on LVM (vg_xfs_media/xfs_db) and must not be touched.
#
# READ THIS BEFORE INSTALLING. /var/media-stack/config lives on nvme0n1p3, so
# the install DESTROYS it: ~6.3GB of Jellyfin metadata, the *arr databases,
# Caddy's certificates and ACME account, and Pocket ID's passkey records. None
# of it is in git and none of it is regenerable. The Stage 0 backup predates
# Caddy, Pocket ID and Tinyauth entirely, so it is not sufficient.
#
#   Back up config/ and verify the restore BEFORE booting the installer.
#
# The media disk survives because it is a different physical device, not
# because anything here protects it.
#
# Everything below is either a rootless-Podman prerequisite or a mount. There is
# deliberately no application configuration here: that lives in stacks/.
# ==============================================================================

kernel_arguments:
  # ---------------------------------------------------------------------------
  # Re-enable SMT
  # ---------------------------------------------------------------------------
  # Fedora CoreOS ships `mitigations=auto,nosmt`, which switches off symmetric
  # multithreading. On this i7-8700K that means 6 usable threads out of 12 - half
  # the machine, and it does not announce itself: lscpu still reports 12 CPUs
  # while `nproc` says 6 and cores 6-11 sit in the offline list.
  #
  # THE RISK IS ACCEPTED DELIBERATELY, and it is not zero. `nosmt` defends
  # against cross-thread side-channel attacks (L1TF, MDS), which need hostile
  # code running on a sibling thread - and FlareSolverr runs attacker-controlled
  # JavaScript in headless Chrome by design, on this host. That makes this the
  # one machine where the mitigation is not theoretical. The judgement is that
  # `net-solver` isolation is the barrier that matters and the threads are worth
  # more here; if that trade stops looking right, this is the line to remove.
  should_not_exist:
    - mitigations=auto,nosmt
  should_exist:
    - mitigations=auto

passwd:
  users:
    # The service user is `core`, the one Fedora CoreOS already ships.
    #
    # uid 1000 is not cosmetic: rootless Podman maps container UID 0 to the
    # invoking user, and every file on the media disk and under config/ is
    # owned by 1000:1000. A different uid means a 7.3TB chown.
    #
    # But FCOS ALREADY has a user at 1000 - `core` - so asking Ignition to
    # create `avanserv` there is not a typo to fix, it is a collision that can
    # never succeed. It failed exactly that way on the first install:
    #
    #   files: ensureUsers: op(2): [failed] creating or modifying user
    #   "avanserv": useradd: UID 1000 is not unique
    #
    # Ignition aborts the whole stage on that, so NOTHING below ran - including
    # the network keyfile. The machine came up with no address at all and, with
    # no console, looked indistinguishable from a machine that never booted.
    #
    # So take the uid that is already there rather than fighting for the name.
    # The filesystem stores uids, not names; `core` owning /mnt/media and
    # `avanserv` owning it are the same bytes on disk. Displacing `core` to
    # another uid would preserve the name, but it depends on Ignition applying
    # usermod in list order, and a wrong guess here costs a trip to the machine.
    #
    # No `groups:` either. `core` is already in wheel and sudo on FCOS -
    # verified by running passwordless sudo as it in the live environment - and
    # every directive omitted is one that cannot fail on a disk with no console.
    - name: core
      # BOTH keys currently in the server's authorized_keys, copied verbatim.
      # Preserving access exactly is worth more than tidying the list: a typo
      # or an omission here produces a machine that needs a keyboard and a
      # monitor to fix, and this config is applied to a disk that has just been
      # wiped. Prune them later, from a machine you can already log in to.
      #
      # These are public keys, which is what makes them safe in a public repo.
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKmkRPuqZlSFi00vRwgPjEm69RiUQMcMALjFx08yGT56 avs@fedora
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICYqV/NrZ1e25EMY5xrL3VWDGiGcwVTYdaFo67hfA4QO avanserv@home.avanserv.com

storage:
  # There is deliberately NO `filesystems:` section. That section exists to
  # create filesystems, and the only one that matters here already exists and
  # holds 391GB of library. Declaring it - even with wipe_filesystem: false -
  # would put a formatting code path within one typo of the media disk for no
  # benefit, since the mount unit below is what actually mounts it.
  files:
    # ------------------------------------------------------------------------
    # A static address, because losing it means losing the machine
    # ------------------------------------------------------------------------
    # The old host took 192.168.0.100 by DHCP, and the router forwards its
    # external SSH port to that fixed address. A new OS presents a new DHCP
    # identity and can be handed a different lease - at which point the forward
    # points at nothing and the machine is unreachable from outside DESPITE the
    # install having succeeded. There is no console here to notice with.
    #
    # A DHCP reservation would also work, but it lives in a router this
    # repository cannot see, cannot verify and cannot restore. This can.
    #
    # Matched on MAC rather than interface name: the hardware address survives
    # the OS change, whereas predictable interface naming is a convention.
    - path: /etc/NetworkManager/system-connections/lan.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=lan
          type=ethernet
          autoconnect=true

          [ethernet]
          mac-address=4C:ED:FB:3F:97:11

          [ipv4]
          method=manual
          address1=192.168.0.100/24,192.168.0.1
          dns=192.168.0.1;

          [ipv6]
          method=auto

    # ------------------------------------------------------------------------
    # Rootless Podman needs to bind 80 and 443
    # ------------------------------------------------------------------------
    # Caddy runs as the service user, and unprivileged processes cannot bind
    # below 1024 by default. Without this the ingress fails to start with a bare
    # "permission denied" and every hostname stops resolving to anything.
    - path: /etc/sysctl.d/80-rootless-ports.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start=80

    # ------------------------------------------------------------------------
    # gluetun needs /dev/net/tun
    # ------------------------------------------------------------------------
    # CoreOS ships it 0600 root:root, which a rootless container cannot open.
    # The failure looks like a VPN that never connects rather than a permission
    # error, and it takes both downloaders with it.
    - path: /etc/udev/rules.d/99-tun.rules
      mode: 0644
      contents:
        inline: |
          KERNEL=="tun", GROUP="core", MODE="0660", OPTIONS+="static_node=net/tun"

    # ------------------------------------------------------------------------
    # Pin the interface name to the MAC
    # ------------------------------------------------------------------------
    # Not required for the address to work - lan.nmconnection matches on MAC and
    # has no interface-name, verified by rebooting onto a kernel with no naming
    # kargs at all. This exists so the machine matches this file.
    #
    # dracut's `ifname=` karg writes exactly this rule into the real root, so a
    # host recovered by typing that karg at GRUB ends up with a `nic0` that a
    # host installed straight from this config would not have. Declaring it
    # removes the divergence, and keeps `ifname=nic0:...` in bin/remote-kexec.sh
    # naming the same interface the installed system uses.
    - path: /etc/udev/rules.d/80-ifname.rules
      mode: 0644
      contents:
        inline: |
          SUBSYSTEM=="net", ACTION=="add", DRIVERS=="?*", ATTR{address}=="4c:ed:fb:3f:97:11", ATTR{type}=="1", NAME="nic0"

    # ------------------------------------------------------------------------
    # Delegate the io controller to the user manager
    # ------------------------------------------------------------------------
    # systemd delegates `cpu memory pids` to a user session by default and NOT
    # `io`, and an undelegated controller is accepted silently and does nothing.
    # So every IOWeight= and IOReadBandwidthMax= in stacks/ was inert, which is
    # not a theoretical gap: a Tdarr health-check sweep - a full-file decode of
    # every file it is given - saturated the media spindle and wedged every
    # userspace process on the box. The kernel kept answering ICMP and
    # completing TCP handshakes while sshd could not get scheduled far enough to
    # send a banner. There is no console here, so it took a power cycle.
    #
    # sda runs BFQ, which is what makes io.weight meaningful rather than
    # advisory. Verify after any change - the failure mode is silence:
    #   systemctl show user@1000.service -p DelegateControllers
    #   cat /sys/fs/cgroup/user.slice/user-1000.slice/cgroup.subtree_control
    - path: /etc/systemd/system/user@.service.d/10-delegate-io.conf
      mode: 0644
      contents:
        inline: |
          [Service]
          Delegate=cpu cpuset io memory pids

    # ------------------------------------------------------------------------
    # Subuid/subgid range for the service user
    # ------------------------------------------------------------------------
    # Rootless Podman needs a mapped range for every UID inside a container
    # other than 0. The images here use 65536 of them.
    - path: /etc/subuid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:100000:65536
    - path: /etc/subgid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:100000:65536

  links:
    # Quadlet reads from ~/.config/containers/systemd. Symlinking the repo
    # directories in means `git pull` + `systemctl --user daemon-reload` is the
    # whole deploy, with no copy step to forget.
    - path: /var/home/core/.config/containers/systemd/common
      target: /var/media-stack/stacks/common
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd/torrent
      target: /var/media-stack/stacks/torrent
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd/media
      target: /var/media-stack/stacks/media
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd/infra
      target: /var/media-stack/stacks/infra
      user: { name: core }
      group: { name: core }

systemd:
  units:
    # ------------------------------------------------------------------------
    # /mnt/media, with its SELinux label set once
    # ------------------------------------------------------------------------
    # This is the reason none of the media Volume= lines carry :z. SELinux is
    # enforcing on CoreOS, so the containers cannot read the disk without a
    # container_file_t label - but letting Podman apply it with :z would
    # recursively relabel 7.3TB on every single container start.
    #
    # `context=` sets one label for the entire mount at mount time, instantly.
    # XFS does support native SELinux xattrs - the current host mounts it with
    # `seclabel` - so this deliberately overrides per-file labels rather than
    # working around their absence. That is the intent: every file on this disk
    # is container content and there is nothing to distinguish.
    #
    # Identified by UUID. The volume has no label, and the device-mapper name
    # depends on the VG being activated first.
    # The unit is var-mnt-media.mount, NOT mnt-media.mount, because on CoreOS
    # /mnt is a symlink to /var/mnt - the same ostree layout that makes /home a
    # symlink to /var/home. systemd derives a mount unit's name from its path
    # and refuses one that is not canonical:
    #
    #   mnt-media.mount: Mount path /mnt/media is not canonical
    #   (contains a symlink).  Failed with result 'resources'.
    #
    # Naming it mnt-media.mount fails on a healthy disk, which is a slow thing
    # to diagnose: vgs, lvs and the by-uuid link all look perfect. Everything
    # else can still say /mnt/media - the symlink resolves for consumers. It is
    # only the unit name and Where= that must be the real path.
    - name: var-mnt-media.mount
      enabled: true
      contents: |
        [Unit]
        Description=Media library (XFS on vg_xfs_media/xfs_db)
        Before=local-fs.target
        # LVM must be assembled before this device node exists.
        Requires=lvm2-monitor.service
        After=lvm2-monitor.service

        [Mount]
        What=/dev/disk/by-uuid/fce53d5f-0849-40dd-81aa-ba21819c7eeb
        Where=/var/mnt/media
        Type=xfs
        Options=rw,relatime,noquota,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    # ------------------------------------------------------------------------
    # Start the stack at boot, without anyone logging in
    # ------------------------------------------------------------------------
    # User units only run while the user has a session. Without lingering, the
    # entire stack starts when someone SSHes in and stops when they leave.
    - name: enable-linger.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable lingering for the service user
        After=systemd-user-sessions.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/loginctl enable-linger core
        # Ignition creates the parent directories for the symlinks above. It
        # applies the declared ownership to them, but this costs nothing and
        # runs in a fully booted system where /var/home/core certainly exists -
        # whereas a root-owned ~/.config breaks `systemctl --user` with a
        # permission error that reads as a Podman problem. Leading `-`: a
        # failure here must never propagate, because it is insurance, not a
        # dependency.
        ExecStart=-/usr/bin/chown -R core:core /var/home/core/.config

        [Install]
        WantedBy=multi-user.target

    # ------------------------------------------------------------------------
    # Let containers open the device nodes they are handed
    # ------------------------------------------------------------------------
    # The udev rule above makes /dev/net/tun readable by the service user, and
    # gluetun.container passes it in with AddDevice=. Neither is sufficient:
    # SELinux still denies container_t access to tun_tap_device_t unless
    # container_use_devices is on, and it ships off.
    #
    # The symptom is not a permission error on the VPN, it is
    #
    #   ERROR checking TUN device: TUN device is not available
    #
    # from a container whose device node is right there - and `ls -l` inside it
    # returns "Permission denied" while the same open() as the service user on
    # the host succeeds. No AVC is logged by default, so the audit log looks
    # clean. gluetun then takes qBittorrent and JOAL down with it, since they
    # share its namespace.
    #
    # Note container_use_dri_devices is already ON in uCore, which is why the
    # GPUs work and this does not - an easy pair to conflate.
    #
    # This widens what a container may do with a device it has been GIVEN; it
    # does not grant access to any device not explicitly passed with AddDevice=.
    # A targeted policy module allowing only container_t -> tun_tap_device_t
    # would be narrower, at the cost of building and shipping policy on an
    # immutable host.
    #
    # Guarded rather than unconditional: setsebool -P rebuilds policy and is
    # slow, and the setting already persists in /etc/selinux across reboots and
    # rpm-ostree updates. This only pays that cost the once.
    - name: selinux-container-devices.service
      enabled: true
      contents: |
        [Unit]
        Description=Allow containers to use device nodes passed to them
        After=local-fs.target
        Before=multi-user.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/sh -c 'getsebool container_use_devices | grep -q " on$" || setsebool -P container_use_devices 1'

        [Install]
        WantedBy=multi-user.target

    # ------------------------------------------------------------------------
    # Open the ports the stack publishes
    # ------------------------------------------------------------------------
    # This is the REVERSE of the old host, and the reversal is the whole point.
    #
    # Under Docker, firewalld could not contain a published container port at
    # all: Docker inserted its own DNAT ahead of firewalld's filtering, so a
    # port stayed reachable no matter what the zone allowed. Rootless Podman
    # publishes through a userspace rootlessport process that binds on the host
    # like any other daemon, so firewalld's INPUT rules DO apply - and the
    # FedoraServer zone ships allowing only ssh, cockpit and dhcpv6-client.
    #
    # So the failure is inverted too. Ports are now closed by default rather
    # than open by default, and the symptom is "No route to host" on 443 while
    # ssh on 22 works perfectly - firewalld REJECTs rather than drops. Caddy
    # looks healthy and logs that it is serving, because it is; nothing reaches
    # it.
    #
    # Ports are spelled out rather than read from .env because this runs at
    # first boot, before the repository is cloned and before .env exists. They
    # must be kept in step with PORT_CADDY_HTTP, PORT_CADDY_HTTPS and
    # PORT_JELLYFIN_WEB.
    - name: firewall-stack-ports.service
      enabled: true
      contents: |
        [Unit]
        Description=Open the host ports the stack publishes
        After=firewalld.service
        Wants=firewalld.service
        Before=multi-user.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        # --permanent --add-* is idempotent; re-adding warns and exits 0.
        ExecStart=/usr/bin/firewall-cmd --permanent --add-service=http
        ExecStart=/usr/bin/firewall-cmd --permanent --add-service=https
        ExecStart=/usr/bin/firewall-cmd --permanent --add-port=8096/tcp
        ExecStart=/usr/bin/firewall-cmd --reload

        [Install]
        WantedBy=multi-user.target

    # ------------------------------------------------------------------------
    # CDI device definitions for the two GPUs
    # ------------------------------------------------------------------------
    # `runtime: nvidia` has no equivalent in Podman; devices are referenced as
    # nvidia.com/gpu=N and that mapping has to be generated once per boot,
    # because it embeds driver library paths that change across updates.
    - name: nvidia-cdi.service
      enabled: true
      contents: |
        [Unit]
        Description=Generate CDI specification for NVIDIA devices
        After=local-fs.target
        Before=multi-user.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml

        [Install]
        WantedBy=multi-user.target
