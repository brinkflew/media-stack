# ==============================================================================
# Rebuild Caddy weekly, well before the nightly auto-update run
# ------------------------------------------------------------------------------
# Sunday 03:00 against podman-auto-update.timer's midnight: the build has to
# have finished and produced an image before auto-update looks, or the restart
# waits another week. Three hours is generous for a ~75s compile, and generous
# is the right call for something nobody watches.
#
# Weekly rather than nightly because this is a source build, not a pull - it
# costs CPU and a full Go toolchain download, and Caddy does not release daily.
#
# Persistent=true so a machine that was off on Sunday rebuilds when it comes
# back rather than skipping a week.
# ==============================================================================

[Unit]
Description=Rebuild the Caddy image weekly

[Timer]
OnCalendar=Sun *-*-* 03:00
Persistent=true
RandomizedDelaySec=15min
AccuracySec=5min

[Install]
WantedBy=timers.target
