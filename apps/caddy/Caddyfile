# ==============================================================================
# Caddy: reverse proxy and TLS terminator
# ------------------------------------------------------------------------------
# One site block per hostname, proxying to a container by name. Caddy joins each
# of the eight segments it needs individually, so a name only resolves where the
# two of them share a network.
#
# Adding a service is two steps: a CNAME to the dynamic-DNS name, and a block
# below. There is no certificate list to maintain - Caddy issues and renews a
# certificate per site block on demand. A hostname with no block gets no
# certificate and fails the TLS handshake, so unlisted names are closed by
# construction rather than by remembering to remove them.
#
# Upstream ports are the ports *inside* the container, which is not always the
# published one. Where an application's listening port is itself driven by the
# environment, the same variable is used here so the two cannot drift.
# ==============================================================================
{
	# Certificates are issued over DNS-01 against Gandi, using a Personal Access
	# Token. DNS-01 needs no inbound port 80, so nothing here depends on the
	# router forwarding it.
	acme_dns gandi {env.GANDI_BEARER_TOKEN}

	# STDOUT, NOT THE DEFAULT STDERR. Podman's journald log driver maps a
	# container's stdout to journal priority 6 and its stderr to priority 3, and
	# Caddy logs to stderr by default - so every "level":"info" line was being
	# recorded as a journal ERROR. That was 1485 false errors a day, enough to
	# make `journalctl -p err` useless and any alerting built on it worthless.
	log {
		output stdout
	}
}

# ------------------------------------------------------------------------------
# Snippets
# ------------------------------------------------------------------------------

# Caddy emits no access log unless asked, and journald is a better home for it
# than a rotated file. Worth having: it was the access log that showed internet
# scanners walking the *arr APIs in the first place.
#
# `output stdout` for the same reason as the global block above - a bare `log`
# here inherits stderr, which podman records as priority 3.
(base) {
	log {
		output stdout
	}
}

# Put a service behind single sign-on. Caddy asks Tinyauth whether the request
# is authorised; Tinyauth runs the OIDC flow against Pocket ID and the passkey
# prompt happens there. Unauthenticated requests are redirected to auth.
#
# The copied headers let a service know who the user is without implementing
# any of this itself, which is what makes it work for applications that have no
# concept of single sign-on.
(protected) {
	import base
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups

		# Tinyauth answers an unauthenticated request with 401 and puts the
		# login URL - already carrying the original address to return to - in
		# X-Tinyauth-Location. It does not send a Location header, so without
		# this the browser is shown a bare 401 instead of the passkey prompt.
		# The snippet in Tinyauth's own Caddy documentation omits this.
		@unauthorized status 401
		handle_response @unauthorized {
			redir * {rp.header.X-Tinyauth-Location}
		}
	}
}

# ------------------------------------------------------------------------------
# Public
# ------------------------------------------------------------------------------
# These cannot sit behind an interactive passkey prompt: TVs, phones and the
# Jellyfin clients have no browser to complete it in. Both applications
# authenticate their own users.
# ------------------------------------------------------------------------------

watch.{$DOMAIN} {
	import base
	reverse_proxy jellyfin:8096
}

request.{$DOMAIN} {
	import base
	reverse_proxy jellyseerr:5055
}

# THE THIRD ONE, AND THE ONE THAT LOOKS WRONG UNTIL YOU READ WHY. ntfy is an
# alerting endpoint, so leaving it outside sign-on invites the obvious
# objection - but the client is the ntfy phone app, which has no browser in
# which to complete a passkey prompt, exactly like the two above. It
# authenticates its own users instead, and auth-default-access is deny-all, so
# an unauthenticated request to this hostname reaches nothing at all.
#
# flush_interval -1 IS LOAD-BEARING, not tuning. ntfy delivers over a
# long-lived streaming response; with Caddy's default buffering a phone
# receives nothing until the buffer fills, which for a one-line alert is never.
# The symptom is a working server, a subscribed phone and silence.
#
# IT STAYS EVEN THOUGH THE APP USES WEBSOCKETS. A WebSocket upgrade bypasses
# HTTP response buffering entirely, so this directive is inert for /ws - but it
# still governs /json and /sse, which are the fallback path, the web UI and any
# curl subscriber. Removing it as redundant would leave those silently dead.
#
# The upgrade itself needs nothing here: Caddy proxies it natively, verified
# rather than assumed - HTTP/1.1 to /home-server/ws returns 101 Switching
# Protocols and the open frame arrives immediately, and an unauthenticated one
# is still refused 403. Note it must be HTTP/1.1: over HTTP/2, which Caddy
# negotiates by default, `Connection: Upgrade` is meaningless and ntfy answers
# 400 "client not using the websocket protocol". That is a red herring when
# testing by hand, not a proxy fault.
ntfy.{$DOMAIN} {
	import base
	reverse_proxy ntfy:80 {
		flush_interval -1
	}
}

# ------------------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------------------
# The sign-on pair itself, which obviously cannot be placed behind its own
# sign-on. Pocket ID insists on HTTPS because WebAuthn refuses to register a
# passkey over a plain connection.
# ------------------------------------------------------------------------------

id.{$DOMAIN} {
	import base
	reverse_proxy pocket-id:1411
}

auth.{$DOMAIN} {
	import base
	reverse_proxy tinyauth:3000
}

# ------------------------------------------------------------------------------
# Administration
# ------------------------------------------------------------------------------
# Every one of these was previously reachable from the internet behind nothing
# but its own login, and the access log shows scanners walking their APIs.
# ------------------------------------------------------------------------------

sonarr.{$DOMAIN} {
	import protected
	reverse_proxy sonarr:8989
}

radarr.{$DOMAIN} {
	import protected
	reverse_proxy radarr:7878
}

prowlarr.{$DOMAIN} {
	import protected
	reverse_proxy prowlarr:9696
}

bazarr.{$DOMAIN} {
	import protected
	reverse_proxy bazarr:6767
}

tdarr.{$DOMAIN} {
	import protected
	reverse_proxy tdarr-server:{$PORT_TDARR_WEB}
}

# qBittorrent and JOAL have no address of their own: both run inside the VPN
# network namespace so that neither can reach the internet outside it.
#
# THE NAME IS `torrent`, THE POD - not `gluetun`, and not either downloader.
# Under Compose these shared gluetun's netns via network_mode: service:gluetun,
# so gluetun was the container attached to net-download and gluetun:8200 was
# the address. Under Podman the pod's INFRA container holds the network, and it
# answers to the pod name. `gluetun:8200` does not resolve here at all - which
# is invisible from outside, because these routes are behind sign-on and an
# unauthenticated request is redirected before Caddy ever dials the backend.
#
# nginx needed seven location blocks each to cover the API, websocket and
# long-poll paths. reverse_proxy handles all of it, websockets included.

torrent.{$DOMAIN} {
	import protected
	reverse_proxy torrent:{$PORT_QBITTORRENT_WEB}
}

fakerr.{$DOMAIN} {
	import protected
	reverse_proxy torrent:{$PORT_JOAL_WEB}
}

# ------------------------------------------------------------------------------
# The agent control plane
# ------------------------------------------------------------------------------
# Windmill drives the coding-agent pipeline. It is behind sign-on like every
# other admin surface here, and the cost of that is deliberate: a Pocket ID
# outage blocks approvals, which is the correct direction. An autonomous agent
# whose gatekeeper is down should fail closed.
#
# 8000, NOT ${PORT_WINDMILL_HTTP}. That variable is 8300, the HOST loopback port
# `conduct` polls; inside the container Windmill listens on a fixed 8000. From a
# container on net-agents, :8000 answers and :8300 is refused. So it is written
# out like sonarr:8989 rather than parameterised, and caddy.container therefore
# needs no Environment= line for it.
#
# THIS BLOCK CARRIES NO PATH GUARD, AND AN EARLIER DRAFT OF THE PLAN SPECIFIED
# ONE: a 403 on /api/w/*/jobs_u/* except resume and cancel, as a second layer
# for the case where forward_auth fails open. It was dropped after reading
# Windmill's own OpenAPI document, and the reasoning is worth keeping because
# the guard reads so plausibly.
#
#   - `jobs_u` is not a small family of webhook endpoints. It is 26 paths, 19 of
#     which the frontend calls: get, get_logs, getupdate, getupdate_sse, queue,
#     completed, get_flow*, get_args, dispatch_events, resume, cancel. It is the
#     UI's entire read path, so 403ing it breaks the application - and the guard
#     runs AFTER forward_auth passes, so it would refuse authenticated users too.
#   - The `_u` suffix means no SESSION required, not no CREDENTIAL required. The
#     document's global security block is bearerAuth or cookieAuth and exactly
#     one path overrides it. The session-free ones carry an HMAC signature in the
#     path; a bogus one returns 400, not 401 - the route exists and rejects it.
#   - There is no authenticated resume endpoint at all. jobs/resume_urls only
#     MINTS the signed URLs. So 403ing jobs_u/resume makes approval impossible.
#
# What replaces the second layer is Windmill's own session auth, which is what
# that document says every non-signature route already requires. The residual
# risk is real and is NOT an ingress problem: a signed jobs_u/resume URL sent to
# ntfy would be a bearer token in a channel deliberately outside sign-on. What
# travels must be the UI's approval page. See docs/agents.md.
#
# flush_interval -1 IS LOAD-BEARING, and confirmed rather than inferred: the
# frontend calls jobs_u/getupdate_sse, so a running job's console is server-sent
# events - exactly ntfy's case, where default buffering shows a blank pane for
# the whole run.
# ------------------------------------------------------------------------------

agents.{$DOMAIN} {
	import protected
	reverse_proxy windmill-server:8000 {
		flush_interval -1
	}
}

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
# Prometheus has no authentication of its own and no concept of a user, so its
# query API and its built-in expression browser would be readable by anyone who
# reached them. It listens only on net-metrics, which makes this block the sole
# path to it from anywhere.
# ------------------------------------------------------------------------------

metrics.{$DOMAIN} {
	import protected

	# THE SIGN-ON IS NOT ENOUGH ON ITS OWN HERE. Prometheus runs with
	# --web.enable-admin-api because the nightly backup needs
	# /api/v1/admin/tsdb/snapshot to copy a consistent TSDB - and the same API
	# carries delete_series, which would let anyone who completed a passkey
	# prompt destroy the history behind every panel. So the admin path is
	# closed at the only public entrance, and the snapshot call is made from
	# the host over the container network instead.
	#
	# Two layers doing different jobs, which is the same shape as the off-site
	# bucket policy and IAM policy: neither is sufficient, and the one that
	# looks complete on its own is the one that is not.
	@admin path /api/v1/admin/*
	respond @admin "not through here" 403

	reverse_proxy prometheus:9090
}

# THE DASHBOARD, and the one block here that is three upstreams rather than one.
#
# The reason it is three is that they are ONE ORIGIN. The page is a Vue
# application in a browser, and everything it reads has to arrive somewhere it
# is allowed to read from - so the bundle, the query API and the alert API are
# all served from this hostname, past this single forward_auth. The alternative
# is the application holding credentials for three services and the browser
# making cross-origin requests to two more names, which is more moving parts,
# more sign-on boundaries, and a CORS policy to maintain.
#
# THE DASHBOARD CONTAINER ITSELF REACHES NOTHING. It serves static files and one
# read-only JSON on net-dashboard, whose only other member is Caddy. It is not
# on net-metrics on purpose - see stacks/common/net-dashboard.network.
#
# A NOTE FOR WHOEVER DEBUGS THIS FIRST: an expired session here is a 302, not a
# 401. forward_auth redirects the browser to auth.{$DOMAIN}, and `fetch` follows
# redirects - so an XHR resolves with res.ok true and an HTML sign-in page as
# its body, and JSON.parse throws somewhere unrelated. The application detects
# it in one place (src/api/http.ts) and reloads the page, because a passkey
# prompt cannot be completed inside an XHR.
home.{$DOMAIN} {
	import protected

	# EACH GUARD LIVES INSIDE ITS OWN handle BLOCK, AND THAT IS NOT A STYLE
	# CHOICE - IT IS THE ONLY PLACE IT WORKS. Caddy executes directives in ITS
	# order, not the order they are written, and `handle` sorts BEFORE
	# `respond`. Written at the top level of this block, next to the handles,
	# both matchers below are dead code: the first `handle` that matches
	# terminates the request and `respond` is never reached.
	#
	# That was not a theory. Written the obvious way, a GET of
	# /api/prom/api/v1/admin/tsdb/snapshot returned 200 and a POST to
	# /api/alerts/api/v2/silences returned 200 - a guard that reads correctly,
	# adapts without error, validates clean, and protects nothing. It is the
	# same shape as the shellcheck leg that reported "all checks passed" over
	# 2,224 lines it had never looked at.
	#
	# Inside a handle, `respond` DOES sort before `reverse_proxy`, which is why
	# the identical construction on metrics.{$DOMAIN} has always worked.
	#
	# TEST IT AFTER TOUCHING IT. `caddy validate` cannot see this class of
	# mistake; only a request can.

	# handle_path strips the prefix before the handlers inside it run, so the
	# matcher below is written against the STRIPPED path - /api/v1/admin/*, not
	# /api/prom/api/v1/admin/*. Getting that wrong is the second way to write a
	# guard that never fires.
	handle_path /api/prom/* {
		# THE SAME REFUSAL metrics.{$DOMAIN} CARRIES, AND FOR THE SAME REASON.
		# Prometheus runs with --web.enable-admin-api because the nightly
		# backup needs /api/v1/admin/tsdb/snapshot, and that API also carries
		# delete_series. This block is a SECOND public entrance to the same
		# store, so it needs its own copy - a matcher on the other hostname
		# protects nothing here.
		@admin path /api/v1/admin/*
		respond @admin "not through here" 403

		reverse_proxy prometheus:9090
	}

	handle_path /api/alerts/* {
		# Alertmanager has had no route at all until now, and it is not getting
		# a writable one. POST /api/v2/silences is how an alert is muted, and
		# muting an alert from a dashboard - without the argument, the duration
		# or the record that goes with it - is precisely how a channel stops
		# being read. ntfy-alertmanager's Silence button was declined for the
		# same reason.
		@write not method GET HEAD
		respond @write "read only" 405

		reverse_proxy alertmanager:9093
	}

	# POSTERS, AND THE ONLY UPSTREAM HERE THAT NEEDS NO CREDENTIAL.
	#
	# Jellyfin's image endpoints answer 200 unauthenticated and every other path
	# on it answers 401 - measured from inside this container, not assumed. That
	# is what makes this cheap: the dashboard holds no credential, Caddy adds
	# none, and if the matcher below is ever wrong the request falls through to
	# Jellyfin's own 401 rather than opening its API. The guard is the first
	# line of defence and not the only one.
	#
	# Same origin rather than watch.{$DOMAIN} on purpose. Cross-origin would
	# work, and it would send 30-60 images per page load out through the router
	# and back in through NAT loopback - measured at about 5x per request - and
	# hang the poster grid off a route that is deliberately outside sign-on.
	handle_path /api/images/* {
		# Written against the STRIPPED path, like the two guards above: the
		# browser asks for /api/images/Items/<id>/Images/Primary and Jellyfin
		# sees /Items/<id>/Images/Primary.
		#
		# `not path_regexp` rather than a path matcher because the item id is
		# the variable part. An id is 32 hex characters; anything else - a
		# traversal, /Sessions, /Users/<id>/Images - is refused here.
		@notimage not path_regexp ^/Items/[a-f0-9]{32}/Images/(Primary|Thumb|Backdrop|Logo)
		respond @notimage "not through here" 403

		# An image proxy has no business carrying a write, and Jellyfin's API
		# does accept POST elsewhere. Cheap to refuse, so refuse it.
		@write not method GET HEAD
		respond @write "read only" 405

		# ONLY A TAGGED REQUEST IS CACHEABLE, and the distinction is the point.
		# The tag is a content hash of that image, so a changed poster changes
		# the URL and a long immutable cache is safe. An untagged request is
		# whatever the current image happens to be, so caching it would pin a
		# stale poster for a year. Jellyfin itself sends a bare `Cache-Control:
		# public` with no max-age, which is why this is set here.
		@tagged query tag=*
		header @tagged Cache-Control "public, max-age=31536000, immutable"

		reverse_proxy jellyfin:8096
	}

	# The bundle. Last, because handle blocks are matched in source order among
	# themselves and this one matches everything.
	handle {
		reverse_proxy dashboard:8080
	}
}

# ------------------------------------------------------------------------------
# Deliberately absent
# ------------------------------------------------------------------------------
# `docker` (Portainer) has no block, and is being removed along with its
# docker.sock mount. Without a block it gets no certificate, so it stops
# answering.
#
# `home` WAS in this list, as Heimdall's old name. It is now the dashboard's,
# which is the thing Heimdall was meant to be and never was.
#
# `watch`, `request` and `ntfy` are the only routes reachable without signing
# in. All three authenticate their own users, and their clients - TVs, phones,
# the Jellyfin apps, the ntfy app - have no browser in which to complete a
# passkey prompt.
# ------------------------------------------------------------------------------
