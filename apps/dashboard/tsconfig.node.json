{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // The fixtures import the app's own topology, types and query catalogue on
  // purpose - that is what stops them drifting from what the pages ask for.
  // Those three modules are deliberately DOM-free so they compile in this
  // project too; anything that touches `window` does not belong in them.
  "include": [
    "vite.config.ts",
    "fixtures/**/*.ts",
    "src/topology.ts",
    "src/types.ts",
    "src/queries.ts"
  ]
}
